# Local browser profiles contain session cookies; logs and state are generated per run.
/temp/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python virtual environments.
/.venv/
/venv/
/env/

# Local credentials/configuration; example templates may be committed.
.env
.env.*
!.env.example
!.env.sample

# Generated logs and coverage output.
*.log
.coverage
.coverage.*
htmlcov/

# Operating-system metadata.
.DS_Store
Thumbs.db
desktop.ini